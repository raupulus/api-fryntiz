includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - bootstrap/
        - config/
        - database/
        - routes/

    # Level 9 is the highest level
    level: 5

    # Tolerar entradas del baseline que apunten a ficheros ya eliminados
    # (evita que PHPStan aborte tras borrar código; regenerar baseline al estabilizar).
    reportUnmatchedIgnoredErrors: false

    # ignoreErrors:
    #     - '#Unsafe usage of new static\(\)#'

    excludePaths:
        - vendor/
        - tests/
        - resources/
        - database/migrations/
